---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import Search from '../components/Search.astro';
import { getPublishedPosts } from '../utils/blog';
import { breadcrumbListJsonLd } from '../utils/schema';
import { generateBreadcrumbs } from '../utils/seo';

const site = Astro.site!;
const posts = await getPublishedPosts();
const breadcrumbItems = generateBreadcrumbs('/busca', site);
---

<BaseLayout
	title="Busca"
	description="Busque profissões, artigos e categorias no O Que Faz. Encontre formação, atuação e mercado de trabalho por palavra-chave."
	canonicalURL="/busca"
	ogImage="/og-default.png"
	ogType="website"
	noindex={true}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(breadcrumbListJsonLd(breadcrumbItems))}
		/>
	</Fragment>

	<div class="page-wrap">
		<BreadcrumbNav items={breadcrumbItems} />
		<h1>Buscar profissão</h1>
		<p>Busca instantânea por nome da profissão, descrição ou categoria — tudo no seu navegador.</p>
		<Search posts={posts} />
		<p class="tags-link">
			<a class="link-brand" href="/tags">Ver todas as categorias →</a>
		</p>
	</div>
</BaseLayout>

<style>
	.page-wrap {
		max-width: 40rem;
		margin: 0 auto;
		padding: 2rem 1rem 3rem;
	}

	.page-wrap h1 {
		margin: 0 0 0.75rem;
		font-size: clamp(1.5rem, 4vw, 2rem);
	}

	.page-wrap > p {
		margin: 0 0 1.5rem;
		color: #475569;
	}

	.tags-link {
		margin-top: 2rem;
	}

	.tags-link {
		margin-top: 2rem;
	}
</style>
