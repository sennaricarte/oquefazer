---
import type { CollectionEntry } from 'astro:content';
import OptimizedImage from './OptimizedImage.astro';
import { formatReadingTime } from '../utils/readingTime';
import { getPostPath, getTagPath } from '../utils/blog';

interface Props {
	post: CollectionEntry<'blog'>;
	readingMinutes?: number;
}

const { post, readingMinutes } = Astro.props;
const { title, description, pubDate, tags, heroImage, heroImageAlt } = post.data;
const postUrl = getPostPath(post);
const formattedDate = pubDate.toLocaleDateString('pt-BR', {
	day: '2-digit',
	month: 'long',
	year: 'numeric',
});
---

<article class="post-card">
	{heroImage && (
		<a href={postUrl} class="post-card__media" tabindex="-1" aria-hidden="true">
			<OptimizedImage
				src={heroImage}
				alt={heroImageAlt ?? title}
				variant="card-feed"
				loading="lazy"
			/>
		</a>
	)}
	<div class="post-card__body">
		<p class="post-card__meta">
			<time datetime={pubDate.toISOString()}>{formattedDate}</time>
			{readingMinutes && (
				<span aria-hidden="true"> · </span>
			)}
			{readingMinutes && <span>{formatReadingTime(readingMinutes)}</span>}
		</p>
		<h2 class="post-card__title">
			<a href={postUrl}>{title}</a>
		</h2>
		<p class="post-card__description">{description}</p>
		{tags.length > 0 && (
			<ul class="post-card__tags" aria-label="Tags do post">
				{tags.map((tag) => (
					<li>
						<a href={getTagPath(tag)} class="post-card__tag">
							{tag}
						</a>
					</li>
				))}
			</ul>
		)}
	</div>
</article>

<style>
	.post-card {
		display: grid;
		gap: 1rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid #e2e8f0;
	}

	.post-card__media :global(.optimized-image) {
		border-radius: 0.5rem;
	}

	.post-card__meta {
		margin: 0;
		font-size: 0.875rem;
		color: #64748b;
	}

	.post-card__title {
		margin: 0.25rem 0;
		font-size: 1.375rem;
		line-height: 1.3;
	}

	.post-card__title a {
		color: var(--color-text);
		text-decoration: none;
	}

	.post-card__title a:hover {
		color: var(--color-brand);
	}

	.post-card__description {
		margin: 0;
		color: var(--color-text-soft);
	}

	.post-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0.75rem 0 0;
		padding: 0;
		list-style: none;
	}

	.post-card__tag {
		display: inline-block;
		padding: 0.2rem 0.65rem;
		font-size: 0.8125rem;
		text-decoration: none;
		color: var(--color-brand);
		background: var(--color-brand-subtle);
		border-radius: 9999px;
	}

	.post-card__tag:hover {
		background: var(--color-brand-muted);
	}

	@media (min-width: 640px) {
		.post-card:has(.post-card__media) {
			grid-template-columns: 220px 1fr;
			align-items: start;
		}
	}
</style>
