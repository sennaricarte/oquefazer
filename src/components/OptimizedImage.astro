---
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata | string;
	alt: string;
	width: number;
	height: number;
	loading?: 'lazy' | 'eager';
	fetchpriority?: 'high' | 'low' | 'auto';
	class?: string;
}

const {
	src,
	alt,
	width,
	height,
	loading = 'lazy',
	fetchpriority,
	class: className,
} = Astro.props;

if (!alt?.trim()) {
	throw new Error('OptimizedImage: o atributo alt é obrigatório.');
}

const widths = [400, 800, 1200];
const aspectRatio = `${width} / ${height}`;
const isSvg =
	typeof src === 'string'
		? src.endsWith('.svg')
		: src.format === 'svg' || src.src.endsWith('.svg');
---

<div
	class:list={['optimized-image', className]}
	style={`--aspect-ratio: ${aspectRatio};`}
>
	{isSvg ? (
		<Image
			src={src}
			alt={alt}
			width={width}
			height={height}
			loading={loading}
			fetchpriority={fetchpriority}
			class="optimized-image__asset"
		/>
	) : (
		<Picture
			src={src}
			alt={alt}
			widths={widths}
			formats={['avif', 'webp']}
			width={width}
			height={height}
			quality="mid"
			loading={loading}
			fetchpriority={fetchpriority}
			pictureAttributes={{ class: 'optimized-image__picture' }}
			class="optimized-image__asset"
		/>
	)}
</div>

<style>
	.optimized-image {
		display: block;
		width: 100%;
		aspect-ratio: var(--aspect-ratio);
		overflow: hidden;
	}

	.optimized-image :global(.optimized-image__picture),
	.optimized-image :global(.optimized-image__asset),
	.optimized-image :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
