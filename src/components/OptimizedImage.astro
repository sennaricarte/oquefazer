---
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	getImagePreset,
	resolveImageQuality,
	type ImageVariant,
} from '../utils/image-presets';

interface Props {
	src: ImageMetadata | string;
	alt: string;
	/** Preset alinhado ao slot de exibição — garante srcset/sizes corretos. */
	variant: ImageVariant;
	loading?: 'lazy' | 'eager';
	fetchpriority?: 'high' | 'low' | 'auto';
	class?: string;
	/** Sobrescreve apenas se o layout exigir exceção documentada. */
	width?: number;
	height?: number;
	widths?: number[];
	sizes?: string;
	quality?: 'low' | 'mid' | 'high' | number;
}

const {
	src,
	alt,
	variant,
	loading = 'lazy',
	fetchpriority,
	class: className,
	width: widthOverride,
	height: heightOverride,
	widths: widthsOverride,
	sizes: sizesOverride,
	quality: qualityOverride,
} = Astro.props;

if (!alt?.trim()) {
	throw new Error('OptimizedImage: o atributo alt é obrigatório.');
}

const preset = getImagePreset(variant);
const width = widthOverride ?? preset.width;
const height = heightOverride ?? preset.height;
const resolvedWidths = widthsOverride ?? preset.widths;
const resolvedSizes = sizesOverride ?? preset.sizes;
const resolvedQuality = qualityOverride ?? resolveImageQuality(preset, loading);

const aspectRatio = `${width} / ${height}`;
const isSvg =
	typeof src === 'string'
		? src.endsWith('.svg')
		: src.format === 'svg' || src.src.endsWith('.svg');
---

<div
	class:list={['optimized-image', className]}
	style={`--aspect-ratio: ${aspectRatio};`}
>
	{isSvg ? (
		<Image
			src={src}
			alt={alt}
			width={width}
			height={height}
			loading={loading}
			fetchpriority={fetchpriority}
			class="optimized-image__asset"
		/>
	) : (
		<Picture
			src={src}
			alt={alt}
			widths={resolvedWidths}
			sizes={resolvedSizes}
			formats={['avif', 'webp']}
			width={width}
			height={height}
			quality={resolvedQuality}
			loading={loading}
			fetchpriority={fetchpriority}
			pictureAttributes={{ class: 'optimized-image__picture' }}
			class="optimized-image__asset"
		/>
	)}
</div>

<style>
	.optimized-image {
		display: block;
		width: 100%;
		aspect-ratio: var(--aspect-ratio);
		overflow: hidden;
	}

	.optimized-image :global(.optimized-image__picture),
	.optimized-image :global(.optimized-image__asset),
	.optimized-image :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
