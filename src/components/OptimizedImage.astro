---
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata | string;
	alt: string;
	width: number;
	height: number;
	loading?: 'lazy' | 'eager';
	fetchpriority?: 'high' | 'low' | 'auto';
	class?: string;
	/** Larguras geradas no srcset — alinhar ao tamanho máximo exibido na tela. */
	widths?: number[];
	/** Atributo sizes para o navegador escolher o arquivo certo do srcset. */
	sizes?: string;
	/** 0–100; padrão mais baixo em lazy para reduzir peso. */
	quality?: 'low' | 'mid' | 'high' | number;
}

const {
	src,
	alt,
	width,
	height,
	loading = 'lazy',
	fetchpriority,
	class: className,
	widths,
	sizes,
	quality,
} = Astro.props;

if (!alt?.trim()) {
	throw new Error('OptimizedImage: o atributo alt é obrigatório.');
}

function buildWidths(displayWidth: number): number[] {
	const candidates = [
		Math.round(displayWidth * 0.75),
		displayWidth,
		Math.round(displayWidth * 1.25),
	];
	return [...new Set(candidates.filter((w) => w >= 160))].sort((a, b) => a - b);
}

const resolvedWidths = widths ?? buildWidths(width);
const resolvedSizes = sizes ?? `(max-width: ${width}px) 100vw, ${width}px`;
const resolvedQuality = quality ?? (loading === 'eager' ? 62 : 50);

const aspectRatio = `${width} / ${height}`;
const isSvg =
	typeof src === 'string'
		? src.endsWith('.svg')
		: src.format === 'svg' || src.src.endsWith('.svg');
---

<div
	class:list={['optimized-image', className]}
	style={`--aspect-ratio: ${aspectRatio};`}
>
	{isSvg ? (
		<Image
			src={src}
			alt={alt}
			width={width}
			height={height}
			loading={loading}
			fetchpriority={fetchpriority}
			class="optimized-image__asset"
		/>
	) : (
		<Picture
			src={src}
			alt={alt}
			widths={resolvedWidths}
			sizes={resolvedSizes}
			formats={['avif', 'webp']}
			width={width}
			height={height}
			quality={resolvedQuality}
			loading={loading}
			fetchpriority={fetchpriority}
			pictureAttributes={{ class: 'optimized-image__picture' }}
			class="optimized-image__asset"
		/>
	)}
</div>

<style>
	.optimized-image {
		display: block;
		width: 100%;
		aspect-ratio: var(--aspect-ratio);
		overflow: hidden;
	}

	.optimized-image :global(.optimized-image__picture),
	.optimized-image :global(.optimized-image__asset),
	.optimized-image :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
