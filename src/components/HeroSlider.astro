---
import type { BlogEntry } from '../utils/blog';
import { getPostPath } from '../utils/blog';
import { formatPostDate, getPrimaryCategory } from '../utils/post';
import OptimizedImage from './OptimizedImage.astro';

interface Props {
	posts: BlogEntry[];
}

const { posts } = Astro.props;
const slides = posts.slice(0, 3);

if (slides.length === 0) {
	return null;
}
---

<section class="hero-slider" aria-label="Destaques principais">
	<div class="hero-slider__slides">
		{slides.map((post, index) => (
			<article
				class="hero-slide"
				id={`hero-slide-${index}`}
				role="tabpanel"
				aria-labelledby={`hero-tab-${index}`}
				aria-hidden={index !== 0}
				style={index === 0 ? undefined : 'display:none'}
				data-hero-slide={index}
			>
				<a class="hero-slide__media" href={getPostPath(post)} tabindex="-1" aria-hidden="true">
					{post.data.heroImage ? (
						<OptimizedImage
							src={post.data.heroImage}
							alt={post.data.heroImageAlt ?? post.data.title}
							width={960}
							height={448}
							widths={[480, 640, 800, 960]}
							sizes="(min-width: 900px) 55vw, 100vw"
							quality={index === 0 ? 62 : 50}
							loading={index === 0 ? 'eager' : 'lazy'}
							fetchpriority={index === 0 ? 'high' : 'auto'}
						/>
					) : (
						<div class="hero-slide__placeholder" />
					)}
					<span class="hero-slide__overlay" />
				</a>
				<div class="hero-slide__content">
					<span class="hero-slide__category">{getPrimaryCategory(post)}</span>
					<time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
					<h2>
						<a href={getPostPath(post)}>{post.data.title}</a>
					</h2>
					<p>{post.data.description}</p>
					<span class="hero-slide__author">Por {post.data.author}</span>
				</div>
			</article>
		))}
	</div>

	{slides.length > 1 && (
		<div class="hero-slider__thumbs" role="tablist" aria-label="Selecionar destaque" aria-orientation="horizontal">
			{slides.map((post, index) => (
				<button
					type="button"
					class="hero-thumb"
					id={`hero-tab-${index}`}
					role="tab"
					aria-selected={index === 0}
					aria-controls={`hero-slide-${index}`}
					tabindex={index === 0 ? 0 : -1}
					data-hero-thumb={index}
				>
					<span class="hero-thumb__title">{post.data.title}</span>
					<time datetime={post.data.pubDate.toISOString()}>
						{formatPostDate(post.data.pubDate)}
					</time>
				</button>
			))}
		</div>
	)}
</section>

<script>
	const slides = document.querySelectorAll('[data-hero-slide]');
	const thumbs = document.querySelectorAll('[data-hero-thumb]');

	function showSlide(index: number) {
		slides.forEach((slide, i) => {
			const el = slide as HTMLElement;
			const active = i === index;
			el.style.display = active ? '' : 'none';
			el.setAttribute('aria-hidden', active ? 'false' : 'true');
		});
		thumbs.forEach((thumb, i) => {
			const active = i === index;
			thumb.setAttribute('aria-selected', active ? 'true' : 'false');
			thumb.setAttribute('tabindex', active ? '0' : '-1');
		});
	}

	thumbs.forEach((thumb) => {
		thumb.addEventListener('click', () => {
			const index = Number((thumb as HTMLElement).dataset.heroThumb);
			showSlide(index);
		});
	});
</script>

<style>
	.hero-slider {
		background: var(--color-dark);
		color: #fff;
	}

	.hero-slider__slides {
		position: relative;
		min-height: 22rem;
	}

	.hero-slide {
		display: grid;
	}

	@media (min-width: 900px) {
		.hero-slide {
			grid-template-columns: 1.2fr 1fr;
			min-height: 26rem;
		}
	}

	.hero-slide__media {
		position: relative;
		display: block;
		min-height: 14rem;
		overflow: hidden;
		text-decoration: none;
	}

	.hero-slide__media :global(.optimized-image) {
		height: 100%;
		min-height: 14rem;
	}

	.hero-slide__media :global(img),
	.hero-slide__media :global(picture) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero-slide__placeholder {
		min-height: 14rem;
		background: linear-gradient(135deg, #134e4a 0%, #0f172a 100%);
	}

	.hero-slide__overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, rgba(15, 23, 42, 0.15), rgba(15, 23, 42, 0.55));
	}

	.hero-slide__content {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.65rem;
		padding: 1.5rem 1.25rem 1.75rem;
	}

	@media (min-width: 900px) {
		.hero-slide__content {
			padding: 2.5rem 2rem;
		}
	}

	.hero-slide__category {
		display: inline-block;
		width: fit-content;
		padding: 0.2rem 0.65rem;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		background: var(--color-accent-strong);
		color: #fff;
	}

	.hero-slide__content time {
		font-size: 0.8125rem;
		color: #94a3b8;
	}

	.hero-slide__content h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		line-height: 1.15;
	}

	.hero-slide__content h2 a {
		color: #fff;
		text-decoration: none;
	}

	.hero-slide__content h2 a:hover {
		color: #99f6e4;
	}

	.hero-slide__content p {
		margin: 0;
		font-size: 0.9375rem;
		color: #cbd5e1;
		line-height: 1.55;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.hero-slide__author {
		font-size: 0.8125rem;
		color: #94a3b8;
	}

	.hero-slider__thumbs {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0;
		margin: 0;
		padding: 0;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
	}

	.hero-thumb {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		width: 100%;
		padding: 0.85rem 1rem;
		text-align: left;
		border: 0;
		border-right: 1px solid rgba(255, 255, 255, 0.08);
		background: rgba(255, 255, 255, 0.04);
		color: #cbd5e1;
		cursor: pointer;
		font: inherit;
	}

	.hero-thumb:last-of-type {
		border-right: 0;
	}

	.hero-thumb[aria-selected='true'] {
		background: var(--color-accent-strong);
		color: #fff;
	}

	.hero-thumb__title {
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1.35;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.hero-thumb time {
		font-size: 0.6875rem;
		color: #94a3b8;
	}

	.hero-thumb[aria-selected='true'] time {
		color: #fff;
	}
</style>
