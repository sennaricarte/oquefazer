# URL canônica do site (astro.config, sitemap, RSS, metadados)
SITE_URL=https://oquefaz.app.br

# Nome do site (SEO, footer, RSS, Open Graph)
SITE_NAME=O Que Faz

# Google Analytics 4 — só carrega em produção (partytown + gtag.js)
PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console — meta tag de verificação de propriedade (HTML tag)
# Obtenha em: Search Console → Configurações → Verificação de propriedade → Tag HTML
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Caminho do gerador de OG dinâmico (query: title, description)
PUBLIC_OG_IMAGE_ENDPOINT=/og

# URL do site antigo para importação (npm run import:site)
# IMPORT_SOURCE_URL=https://seusite-antigo.com.br

# Imagens de capa nos artigos (npm run fetch:image)
# Pexels: https://www.pexels.com/api/
# Pixabay: https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Opcionais
PUBLIC_BLOG_DESCRIPTION=Guia completo de profissões: o que faz, formação, habilidades e mercado de trabalho.
PUBLIC_AUTHOR_NAME=Redação
PUBLIC_CONTACT_EMAIL=contato@oquefaz.app.br
